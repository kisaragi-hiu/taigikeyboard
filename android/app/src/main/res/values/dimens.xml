    <!-- CROSS-PLATFORM INVARIANT: iOS KeyboardKit button insets (6pt / 9pt gaps between keys). -->
    <dimen name="key_marginH">3dp</dimen>
    <dimen name="key_marginV">4.5dp</dimen>

    <dimen name="key_borderRadius">6dp</dimen>

    <dimen name="key_popup_textSize">21sp</dimen>

    <dimen name="media_bottom_button_width">60dp</dimen>
    <dimen name="media_bottom_button_height">@dimen/key_height</dimen>

    <dimen name="smartbar_height">56dp</dimen>
    <dimen name="smartbar_button_margin">1dp</dimen>
    <dimen name="smartbar_button_padding">6dp</dimen>
</resources>
