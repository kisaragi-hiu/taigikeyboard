<?xml version="1.0" encoding="utf-8"?>
<!--
  The IBus component registration for TaigiKeyboard. Installed as
  @PREFIX@/share/ibus/component/taigikeyboard.xml (linux/Makefile renders
  @PREFIX@, @LIBEXECDIR@ and @VERSION@ — @LIBEXECDIR@ is the same variable the
  engine is installed under, per distribution layout); ibus-daemon reads the
  directory at start and spawns <exec> on demand. Design record:
  docs/architecture/linux-roadmap.md L1.
-->
<component>
  <name>org.freedesktop.IBus.TaigiKeyboard</name>
  <description>TaigiKeyboard input method engine</description>
  <exec>@LIBEXECDIR@/ibus-engine-taigikeyboard --ibus</exec>
  <version>@VERSION@</version>
  <author>TaigiKeyboard</author>
  <license>Apache-2.0</license>
  <homepage>https://taigikeyboard.tw</homepage>
  <textdomain>taigikeyboard</textdomain>
  <engines>
    <engine>
      <name>taigikeyboard</name>
      <language>nan</language>
      <license>Apache-2.0</license>
      <author>TaigiKeyboard</author>
      <icon>taigikeyboard</icon>
      <!-- default = keep the user's keyboard layout (Dvorak, Colemak, …);
           `us` made GNOME switch to US QWERTY whenever this engine was
           selected. Same policy as the Fcitx5 addon, which follows the
           group layout. -->
      <layout>default</layout>
      <longname>台語齒盤</longname>
      <description>Taiwanese (Tâi-gí) — TL / POJ romanization, Hanji candidates</description>
      <symbol>台</symbol>
      <!-- The property whose icon / symbol the panel shows while this engine
           is on: the menu root, which carries the mode indicator
           (chrome::mode_indicator). -->
      <icon_prop_key>InputMode</icon_prop_key>
      <rank>0</rank>
      <setup>@PREFIX@/bin/taigikeyboard-settings</setup>
    </engine>
  </engines>
</component>
